<UserControl x:Class="WhaleLauncher.Views.KnowledgePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
<Grid Margin="28,24,32,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0"><TextBlock Text="知识库" Style="{StaticResource H1}"/><TextBlock Text="添加本地文件 / 文件夹或 HTTP(S) 文本来源。加载的相关段落会按关键词加入聊天上下文。" Style="{StaticResource Small}" Margin="0,5,0,14"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource Card}" Padding="12"><DockPanel><Button DockPanel.Dock="Bottom" Content="刷新列表" Style="{StaticResource Ghost}" Click="OnRefresh" Margin="0,10,0,0"/><ListBox x:Name="SourceList" BorderThickness="0" Background="Transparent" SelectionChanged="OnSelect"/></DockPanel></Border>
<Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"><StackPanel>
<TextBlock Text="知识来源" Style="{StaticResource H2}" Margin="0,0,0,10"/><TextBlock Text="唯一 ID" Style="{StaticResource Label}"/><TextBox x:Name="IdBox" Margin="0,4,0,10"/>
<TextBlock Text="来源类型" Style="{StaticResource Label}"/><ComboBox x:Name="TypeBox" SelectedIndex="0" Margin="0,4,0,10"><ComboBoxItem Content="本地路径" Tag="local"/><ComboBoxItem Content="网络 URL" Tag="remote"/></ComboBox>
<TextBlock Text="文件 / 文件夹路径或 URL" Style="{StaticResource Label}"/><TextBox x:Name="PathBox" Margin="0,4,0,10"/>
<CheckBox x:Name="EnabledBox" Content="启用此来源" IsChecked="True" Margin="0,0,0,12"/>
<WrapPanel><Button Content="测试加载" Style="{StaticResource Ghost}" Click="OnTest" Margin="0,0,8,0"/><Button Content="保存来源" Style="{StaticResource Primary}" Click="OnSave" Margin="0,0,8,0"/><Button Content="删除来源" Style="{StaticResource Ghost}" Click="OnDelete"/></WrapPanel>
<TextBlock Text="安全提示：网络来源拒绝重定向及本机/内网 IP；本地文件仅读取 txt、md、json、csv，单次最多 1 MiB。" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,14,0,0"/>
</StackPanel></Border></Grid><TextBlock x:Name="StatusText" Grid.Row="2" Style="{StaticResource Small}" Margin="0,12,0,0" Text="知识库尚未加载"/></Grid></UserControl>