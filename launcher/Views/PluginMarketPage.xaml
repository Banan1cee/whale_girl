<UserControl x:Class="WhaleLauncher.Views.PluginMarketPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <Grid Margin="28,24,32,20">
        <DockPanel x:Name="ListPanel">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button x:Name="DocumentsToggle" DockPanel.Dock="Right" Content="文档（必看） ▾"
                        Style="{StaticResource Ghost}" Click="OnToggleDocuments" Margin="8,0,0,0"
                        AutomationProperties.Name="文档（必看）" AutomationProperties.HelpText="展开文档列表" />
                <Button DockPanel.Dock="Right" Content="从本地安装…" Style="{StaticResource Ghost}"
                        Click="OnLocal" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource Ghost}"
                        Click="OnRefresh" Margin="8,0,0,0" />
                <TextBlock Text="插件市场" Style="{StaticResource H1}" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer x:Name="MarketScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="发现社区工具与人设预设，在「已安装」里管理。"
                               Style="{StaticResource Small}" Margin="0,0,0,14" />
                    <Border x:Name="DocumentsPanel" Style="{StaticResource Card}" Visibility="Collapsed"
                            Padding="16" Margin="0,0,0,14">
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="安装与使用" Style="{StaticResource H2}" Margin="0,0,0,4" />
                                <Button Content="下载与安装指南" Style="{StaticResource Ghost}" Click="OnDownloadGuide" Margin="0,4,0,0" />
                                <Button Content="免责声明" Style="{StaticResource Ghost}" Click="OnDisclaimer" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="插件开发" Style="{StaticResource H2}" Margin="0,0,0,4" />
                                <Button Content="插件作者入门" Style="{StaticResource Ghost}" Click="OnAuthorGuide" Margin="0,4,0,0" />
                                <Button Content="消息插件 API" Style="{StaticResource Ghost}" Click="OnMessageGuide" Margin="0,4,0,0" />
                                <Button Content="JavaScript API 4" Style="{StaticResource Ghost}" Click="OnJavaScriptGuide" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="投稿与审核" Style="{StaticResource H2}" Margin="0,0,0,4" />
                                <Button Content="插件市场规范" Style="{StaticResource Ghost}" Click="OnRulesGuide" Margin="0,4,0,0" />
                                <Button Content="安全检测与溯源" Style="{StaticResource Ghost}" Click="OnSecurityGuide" Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <CheckBox x:Name="JavaScriptEnabled" Content="启用 JavaScript 插件（实验性，完整系统权限）"
                              Click="OnJavaScriptEnabled" Margin="0,0,0,8" />
                    <TextBlock Text="默认关闭。仅启用信任的作者；JavaScript 可访问网络、文件、系统命令和全部主程序 API。更新后需重新确认启用。"
                               Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="第三方插件免责声明" FontWeight="SemiBold" />
                            <TextBlock Text="社区插件由各自作者提供。上架、校验或扫描不保证无病毒、无漏洞；使用可能造成隐私泄露、数据损坏、异常发言或账号风险。请核对来源与权限，备份后谨慎安装。完整说明见「文档（必看）」中的「免责声明」。"
                                       Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <DockPanel LastChildFill="False">
                        <Button x:Name="Discover" Content="发现" Style="{StaticResource Primary}" Click="OnDiscover" MinWidth="80" />
                        <Button x:Name="Installed" Content="已安装" Style="{StaticResource Ghost}" Click="OnInstalled" Margin="8,0,0,0" MinWidth="80" />
                        <TextBox x:Name="Search" DockPanel.Dock="Right" Width="208" Margin="10,0,0,0"
                                 AutomationProperties.Name="搜索插件" ToolTip="按插件名称、作者或简介搜索" TextChanged="OnSearch" />
                    </DockPanel>
                    <DockPanel LastChildFill="True" Margin="0,12,0,0">
                        <TextBlock Text="分类" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,4" />
                        <WrapPanel x:Name="Categories">
                            <Button Content="全部" Tag="" Style="{StaticResource Primary}" Click="OnCategory" Padding="12,6" Margin="0,0,6,4" />
                            <Button Content="人格预设" Tag="persona" Style="{StaticResource Ghost}" Click="OnCategory" Padding="12,6" Margin="0,0,6,4" />
                            <Button Content="消息插件" Tag="message" Style="{StaticResource Ghost}" Click="OnCategory" Padding="12,6" Margin="0,0,6,4" />
                            <Button Content="功能工具" Tag="tool" Style="{StaticResource Ghost}" Click="OnCategory" Padding="12,6" Margin="0,0,6,4" />
                        </WrapPanel>
                    </DockPanel>
                    <TextBlock x:Name="Status" Style="{StaticResource Small}" Margin="0,6,0,8" TextWrapping="Wrap" />
                    <Grid x:Name="Cards">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
            <Button DockPanel.Dock="Top" Content="← 返回插件市场" Style="{StaticResource Ghost}"
                    HorizontalAlignment="Left" Click="OnBack" Margin="0,0,0,10" />
            <ContentControl x:Name="DetailContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </DockPanel>
    </Grid>
</UserControl>
