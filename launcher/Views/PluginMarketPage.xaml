<UserControl x:Class="WhaleLauncher.Views.PluginMarketPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <Grid Margin="28,24,32,20">
        <DockPanel x:Name="ListPanel">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button x:Name="DocumentsToggle" DockPanel.Dock="Right" Content="文档（必看） ▾"
                        Style="{StaticResource Ghost}" Click="OnToggleDocuments" Margin="8,0,0,0"
                        AutomationProperties.Name="文档（必看）" AutomationProperties.HelpText="展开文档菜单" />
                <Button DockPanel.Dock="Right" Content="从本地安装…" Style="{StaticResource Ghost}"
                        Click="OnLocal" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource Ghost}"
                        Click="OnRefresh" Margin="8,0,0,0" />
                <TextBlock Text="插件市场" Style="{StaticResource H1}" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer x:Name="MarketScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="发现人设预设；新协议功能插件与主题可从本地安装。"
                               Style="{StaticResource Small}" Margin="0,0,0,14" />

                    <CheckBox x:Name="PluginsEnabled" Content="启用统一协议插件"
                              Click="OnPluginsEnabled" Margin="0,0,0,8" />
                    <TextBlock Text="默认关闭。1–3 级使用受限 Wasm；4 级须确认完整系统权限。主题不受总开关影响。"
                               Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="Discover" Content="发现" Style="{StaticResource Primary}" Click="OnDiscover" MinWidth="80" />
                            <Button x:Name="Installed" Content="已安装" Style="{StaticResource Ghost}" Click="OnInstalled" Margin="8,0,0,0" MinWidth="80" />
                            <TextBlock Text="分类" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="16,0,10,0" />
                        </StackPanel>
                        <WrapPanel x:Name="Categories" Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="全部" Tag="" Style="{StaticResource Primary}" Click="OnCategory" Padding="12,6" Margin="0,0,6,4" />
                            <Button Content="人格预设" Tag="persona" Style="{StaticResource Ghost}" Click="OnCategory" Padding="12,6" Margin="0,0,6,4" />
                            <Button Content="消息插件" Tag="message" Style="{StaticResource Ghost}" Click="OnCategory" Padding="12,6" Margin="0,0,6,4" />
                            <Button Content="功能工具" Tag="tool" Style="{StaticResource Ghost}" Click="OnCategory" Padding="12,6" Margin="0,0,6,4" />
                        </WrapPanel>
                        <TextBox x:Name="Search" Grid.Column="2" Width="208" Margin="10,0,0,0" VerticalAlignment="Center"
                                 AutomationProperties.Name="搜索插件" ToolTip="按插件名称、作者或简介搜索" TextChanged="OnSearch" />
                    </Grid>
                    <TextBlock x:Name="Status" Style="{StaticResource Small}" Margin="0,6,0,8" TextWrapping="Wrap" />
                    <!-- 列定义由 PluginCardLayout 按实际可用宽度动态生成：
                         这里写死列会退化成固定三列，只给卡片留 Margin 又会让列宽溢出。 -->
                    <Grid x:Name="Cards"></Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
            <Button DockPanel.Dock="Top" Content="← 返回插件市场" Style="{StaticResource Ghost}"
                    HorizontalAlignment="Left" Click="OnBack" Margin="0,0,0,10" />
            <ContentControl x:Name="DetailContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </DockPanel>

        <!-- 文档从卡片改为按钮下拉菜单：文档越多越不该占用市场列表的纵向空间。 -->
        <Popup x:Name="DocumentsMenu" PlacementTarget="{Binding ElementName=DocumentsToggle}"
               Placement="Bottom" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" Opened="OnDocumentsOpened" Closed="OnDocumentsClosed">
            <Border Background="{StaticResource PopupBg}" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="8" MinWidth="236">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="#000000" />
                </Border.Effect>
                <StackPanel ButtonBase.Click="OnDocumentChosen">
                    <TextBlock Text="安装与使用" Style="{StaticResource Label}" Margin="8,6,8,4" />
                    <Button Content="下载与安装指南" Style="{StaticResource Ghost}" HorizontalContentAlignment="Left"
                            Click="OnDownloadGuide" Margin="0,2,0,0" />
                    <Button Content="免责声明" Style="{StaticResource Ghost}" HorizontalContentAlignment="Left"
                            Click="OnDisclaimer" Margin="0,2,0,0" />
                    <Border Height="1" Background="{StaticResource Line}" Margin="8,8" />
                    <TextBlock Text="插件开发" Style="{StaticResource Label}" Margin="8,0,8,4" />
                    <Button Content="插件作者入门" Style="{StaticResource Ghost}" HorizontalContentAlignment="Left"
                            Click="OnAuthorGuide" Margin="0,2,0,0" />
                    <Button Content="插件协议（whale-plugin/1）" Style="{StaticResource Ghost}" HorizontalContentAlignment="Left"
                            Click="OnProtocolGuide" Margin="0,2,0,0" />
                    <Border Height="1" Background="{StaticResource Line}" Margin="8,8" />
                    <TextBlock Text="投稿与审核" Style="{StaticResource Label}" Margin="8,0,8,4" />
                    <Button Content="插件市场规范" Style="{StaticResource Ghost}" HorizontalContentAlignment="Left" Click="OnRulesGuide" Margin="0,2,0,0" />
                    <Button Content="安全检测与溯源" Style="{StaticResource Ghost}" HorizontalContentAlignment="Left"
                            Click="OnSecurityGuide" Margin="0,2,0,6" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- 首次进入的免责声明门禁：覆盖整页，确认前页面不可交互。 -->
        <Grid x:Name="GateHost" Panel.ZIndex="200" Visibility="Collapsed" />
    </Grid>
</UserControl>
