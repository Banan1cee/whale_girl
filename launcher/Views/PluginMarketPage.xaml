<UserControl x:Class="WhaleLauncher.Views.PluginMarketPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <Grid Margin="28,24,32,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>
        <DockPanel x:Name="ListPanel" Margin="0,0,14,0">
            <StackPanel DockPanel.Dock="Top">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="插件市场" Style="{StaticResource H1}" />
                    <Button DockPanel.Dock="Right" Content="从本地安装…" Style="{StaticResource Ghost}" Click="OnLocal" />
                    <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource Ghost}" Click="OnRefresh" Margin="0,0,8,0" />
                </DockPanel>
                <TextBlock Text="发现社区工具与人设预设，在「已安装」里管理。" Style="{StaticResource Small}" Margin="0,6,0,16" />
                <DockPanel LastChildFill="False">
                    <Button x:Name="Discover" Content="发现" Style="{StaticResource Primary}" Click="OnDiscover" MinWidth="80" />
                    <Button x:Name="Installed" Content="已安装" Style="{StaticResource Ghost}" Click="OnInstalled" Margin="8,0,0,0" MinWidth="80" />
                    <TextBox x:Name="Search" Width="154" Margin="16,0,0,0" ToolTip="按插件名称、作者或简介搜索" TextChanged="OnSearch" />
                </DockPanel>
                <TextBlock x:Name="Status" Style="{StaticResource Small}" Margin="0,12,0,8" TextWrapping="Wrap" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="Cards" />
            </ScrollViewer>
        </DockPanel>

        <DockPanel x:Name="DetailPanel" Margin="0,0,14,0" Visibility="Collapsed">
            <Button DockPanel.Dock="Top" Content="← 返回插件市场" Style="{StaticResource Ghost}"
                    HorizontalAlignment="Left" Click="OnBack" Margin="0,0,0,10" />
            <ContentControl x:Name="DetailContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </DockPanel>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="文档" Style="{StaticResource H2}" />
                <Button Content="下载与安装指南" Style="{StaticResource Ghost}" Click="OnDownloadGuide" Margin="0,8,0,0" />
                <Button Content="插件作者入门" Style="{StaticResource Ghost}" Click="OnAuthorGuide" Margin="0,6,0,0" />
                <Button Content="插件市场规范" Style="{StaticResource Ghost}" Click="OnRulesGuide" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
