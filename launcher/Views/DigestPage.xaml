<UserControl x:Class="WhaleLauncher.Views.DigestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：生成 / 复制放在右上角，和其他页一致 -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock Text="消息汇总" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <Button x:Name="BtnCopy" DockPanel.Dock="Right" Content="复制" Style="{StaticResource Ghost}"
                    Click="OnCopy" Margin="8,0,0,0" MinWidth="72" />
            <Button x:Name="BtnGenerate" DockPanel.Dock="Right" Content="生成汇总" Style="{StaticResource Primary}"
                    Click="OnGenerate" MinWidth="96" />
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,8,0,14">
            <TextBlock Text="把一段时间的聊天记录整理成简报。生成时会把选中的聊天片段交给当前模型，使用云端模型时会发送给模型服务商。"
                       Style="{StaticResource Small}" TextWrapping="Wrap" />
            <DockPanel Margin="0,12,0,0" LastChildFill="False">
                <ComboBox x:Name="RangeBox" Width="112" Style="{StaticResource DarkCombo}" SelectionChanged="OnRangeChanged">
                    <ComboBoxItem Content="今天" Tag="today" IsSelected="True" />
                    <ComboBoxItem Content="昨天" Tag="yesterday" />
                </ComboBox>
                <TextBlock x:Name="StatusText" Style="{StaticResource Small}" Margin="12,0,0,0"
                           VerticalAlignment="Center" TextWrapping="Wrap" Text="还没有生成汇总" />
            </DockPanel>
            <TextBlock x:Name="StatsText" Style="{StaticResource Small}" Margin="0,8,0,0"
                       Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="Output" Text="还没有生成汇总。" Style="{StaticResource Value}"
                           TextWrapping="Wrap" LineHeight="23" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
