<UserControl x:Class="WhaleLauncher.Views.SkillsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
<Grid Margin="28,24,32,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0"><TextBlock Text="自定义技能" Style="{StaticResource H1}"/><TextBlock Text="用关键词触发提示词技能；技能以 JSON 保存在 data/custom-skills.json，不执行任意脚本。" Style="{StaticResource Small}" Margin="0,5,0,14"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource Card}" Padding="12"><DockPanel><Button DockPanel.Dock="Bottom" Content="刷新列表" Style="{StaticResource Ghost}" Click="OnRefresh" Margin="0,10,0,0"/><ListBox x:Name="SkillList" SelectionChanged="OnSelect" BorderThickness="0" Background="Transparent"/></DockPanel></Border>
<Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="技能配置" Style="{StaticResource H2}" Margin="0,0,0,10"/>
<TextBlock Text="唯一 ID" Style="{StaticResource Label}"/><TextBox x:Name="IdBox" Margin="0,4,0,10"/>
<TextBlock Text="技能名称" Style="{StaticResource Label}"/><TextBox x:Name="NameBox" Margin="0,4,0,10"/>
<TextBlock Text="描述（可选）" Style="{StaticResource Label}"/><TextBox x:Name="DescriptionBox" Margin="0,4,0,10"/>
<TextBlock Text="触发关键词（逗号分隔）" Style="{StaticResource Label}"/><TextBox x:Name="KeywordsBox" Margin="0,4,0,10"/>
<TextBlock Text="技能指令 / 提示词" Style="{StaticResource Label}"/><TextBox x:Name="ContentBox" Height="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,10"/>
<CheckBox x:Name="EnabledBox" Content="启用此技能" IsChecked="True" Margin="0,0,0,12"/>
<WrapPanel><Button Content="新建 / 保存" Style="{StaticResource Primary}" Click="OnSave" Margin="0,0,8,0"/><Button Content="删除选中技能" Style="{StaticResource Ghost}" Click="OnDelete"/><Button Content="清空表单" Style="{StaticResource Ghost}" Click="OnClear" Margin="8,0,0,0"/></WrapPanel>
</StackPanel></ScrollViewer></Border></Grid>
<TextBlock x:Name="StatusText" Grid.Row="2" Style="{StaticResource Small}" Margin="0,12,0,0" Text="技能尚未加载"/>
</Grid></UserControl>