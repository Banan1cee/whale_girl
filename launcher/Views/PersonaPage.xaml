<UserControl x:Class="WhaleLauncher.Views.PersonaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WhaleLauncher"
             Background="Transparent">
    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Padding" Value="0,4,0,6" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="28,24,32,20" KeyboardNavigation.TabNavigation="Continue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <TextBlock Text="人设" Style="{StaticResource H1}" DockPanel.Dock="Left" />
                <Button Content="重新读取" Style="{StaticResource Ghost}" Click="OnReload" DockPanel.Dock="Right" />
            </DockPanel>
            <TextBlock Text="先设定内心，再选择表达。自动保存成功后，下一轮对话生效。"
                       Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <ScrollViewer x:Name="Body" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0" MaxWidth="1100" HorizontalAlignment="Stretch">
                <Border x:Name="SecPreset" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="人设与预设" Style="{StaticResource H2}" />
                        <TextBlock x:Name="CurrentPreset" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="BtnPersonaTitle" Content="点击编辑人设名称" Style="{StaticResource Ghost}" Click="OnEditPersonaTitle" HorizontalContentAlignment="Left" Margin="0,0,12,0" />
                            <ComboBox x:Name="CmbPreset" Grid.Column="1" MinWidth="200" HorizontalAlignment="Stretch" SelectionChanged="OnPresetChanged" AutomationProperties.Name="选择人设预设" />
                        </Grid>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="应用选中预设" Style="{StaticResource Ghost}" Click="OnImportPreset" Margin="0,0,8,8" />
                            <Button x:Name="BtnSavePreset" Content="创建自定义人设" Style="{StaticResource Ghost}" Click="OnSavePreset" Margin="0,0,8,8" />
                            <Button Content="打包分享" Style="{StaticResource Ghost}" Click="OnExportPersona" Margin="0,0,8,8" />
                            <Button Content="仅分享提示词" Style="{StaticResource Ghost}" Click="OnExportPrompt" Margin="0,0,8,8" />
                            <Button x:Name="BtnCopyPreset" Content="复制为自建预设" Style="{StaticResource Ghost}" Click="OnCopyPreset" Visibility="Collapsed" Margin="0,0,8,8" />
                            <Button x:Name="BtnUpdatePreset" Content="更新此预设" Style="{StaticResource Ghost}" Click="OnUpdatePreset" Margin="0,0,8,8" />
                            <Button x:Name="BtnResetMarket" Content="恢复作者版本" Style="{StaticResource Ghost}" Click="OnResetMarket" Margin="0,0,8,8" />
                            <Button x:Name="BtnRenamePreset" Content="重命名" Style="{StaticResource Ghost}" Click="OnRenamePreset" Margin="0,0,8,8" />
                            <Button x:Name="BtnDeletePreset" Content="删除预设" Style="{StaticResource Ghost}" Click="OnDeletePreset" Margin="0,0,8,8" />
                            <TextBlock x:Name="PresetSaved" Style="{StaticResource Small}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock x:Name="PresetLockHint" Style="{StaticResource Small}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,12"
                                   Text="所有人设均可编辑；创建自定义人设可另存当前内容，原始内置文件不变。" />
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,8,0,16" />
                        <TextBlock Text="内在性格" Style="{StaticResource H2}" />
                        <TextBlock Text="这些基础字段定义她是谁。自定义内容用于补充，冲突时以当前基础字段为准。" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Margin="0,0,12,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Label Content="名字" Target="{Binding ElementName=TxtName}" />
                                <TextBlock Grid.Column="1" Text="请务必与当前登录微信账号的昵称保持一致，避免群聊中因名称识别不一致而漏回消息。"
                                           Style="{StaticResource Small}" Foreground="{DynamicResource Bad}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </Grid>
                            <TextBox Grid.Row="1" x:Name="TxtName" Margin="0,0,12,0" LostFocus="OnFieldLostFocus" AutomationProperties.Name="名字" />
                            <Label Grid.Column="1" Content="年龄" Target="{Binding ElementName=TxtAge}" VerticalAlignment="Center" />
                            <ui:NumberField Grid.Row="1" Grid.Column="1" x:Name="TxtAge" Minimum="1" Maximum="120" Fallback="23" Label="年龄" LostFocus="OnFieldLostFocus" />
                        </Grid>
                        <Label Content="职业" Target="{Binding ElementName=TxtJob}" Margin="0,8,0,0" />
                        <TextBox x:Name="TxtJob" LostFocus="OnFieldLostFocus" AutomationProperties.Name="职业" />
                        <Label Content="性格" Target="{Binding ElementName=TxtPerson}" Margin="0,8,0,0" />
                        <TextBox x:Name="TxtPerson" MinHeight="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" LostFocus="OnFieldLostFocus" AutomationProperties.Name="内在性格" />
                        <Expander Header="外观与经历" Margin="0,16,0,0" Foreground="{DynamicResource Text}">
                            <StackPanel Margin="0,8,0,0">
                                <Label Content="外观" Target="{Binding ElementName=TxtLook}" />
                                <TextBox x:Name="TxtLook" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" LostFocus="OnFieldLostFocus" AutomationProperties.Name="外观" />
                                <Label Content="背景经历" Target="{Binding ElementName=TxtBack}" Margin="0,8,0,0" />
                                <TextBox x:Name="TxtBack" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" LostFocus="OnFieldLostFocus" AutomationProperties.Name="背景经历" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="自定义补充提示词" Margin="0,16,0,0" Foreground="{DynamicResource Text}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="可写说话细节、喜好和补充经历；无需重复当前名字、开关和能力说明。内容随每轮请求发送，越长越占输入预算。" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBox x:Name="TxtPrompt" MinHeight="120" MaxHeight="320" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" LostFocus="OnFieldLostFocus" AutomationProperties.Name="自定义补充提示词" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
                <Border x:Name="SecRelation" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="身份关系" Style="{StaticResource H2}" />
                        <TextBlock Text="称呼不等于权限。微信主人按不可修改的账号 ID 认证，昵称或自称不能授予权限。" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,12" />
                        <Label Content="她怎么叫你" Target="{Binding ElementName=TxtOwner}" />
                        <TextBox x:Name="TxtOwner" LostFocus="OnFieldLostFocus" AutomationProperties.Name="对主人的称呼" />
                        <Label Content="主人账号" Target="{Binding ElementName=TxtMasterSearch}" Margin="0,10,0,0" />
                        <WrapPanel x:Name="MasterChips" />
                        <TextBox x:Name="TxtMasterSearch" Margin="0,6,0,0" TextChanged="OnMasterSearchChanged" AutomationProperties.Name="搜索主人联系人" />
                        <TextBlock x:Name="MasterHint" Text="搜索名字、备注或账号 ID，选择匹配联系人。" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="MasterWarn" Style="{StaticResource Small}" TextWrapping="Wrap" Foreground="{DynamicResource Warn}" Visibility="Collapsed" Margin="0,6,0,0" />
                        <ListBox x:Name="MasterSuggest" MaxHeight="170" Margin="0,6,0,0" Visibility="Collapsed" SelectionChanged="OnMasterSuggestionPicked" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="匹配的主人联系人">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,3"><TextBlock Text="{Binding Display}" /><TextBlock Text="{Binding Sub}" Style="{StaticResource Small}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Label Content="她的别名 / 外号（一行一个）" Target="{Binding ElementName=TxtAliases}" Margin="0,10,0,0" />
                        <TextBox x:Name="TxtAliases" MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" LostFocus="OnFieldLostFocus" AutomationProperties.Name="角色别名，一行一个" />
                    </StackPanel>
                </Border>
                <Border x:Name="SecExpression" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="表达偏好" Style="{StaticResource H2}" />
                        <CheckBox x:Name="ChkRoast" Content="主动顶嘴" Click="OnToggleField" Margin="0,16,0,12" />
                        <CheckBox x:Name="ChkProactive" Content="主动延伸话题" Click="OnToggleField" Margin="0,0,0,12" />
                        <CheckBox x:Name="ChkOpinions" Content="主动表达观点" Click="OnToggleField" Margin="0,0,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><Label Content="私聊字数上限" Target="{Binding ElementName=TxtPrivate}" /><ui:NumberField x:Name="TxtPrivate" Minimum="40" Maximum="800" Fallback="100" Label="私聊字数上限" LostFocus="OnFieldLostFocus" /><TextBlock x:Name="HintPrivate" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                            <StackPanel Grid.Column="1"><Label Content="群聊字数上限" Target="{Binding ElementName=TxtGroup}" /><ui:NumberField x:Name="TxtGroup" Minimum="20" Maximum="300" Fallback="70" Label="群聊字数上限" LostFocus="OnFieldLostFocus" /><TextBlock x:Name="HintGroup" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                        </Grid>
                        <TextBlock Text="普通回复遵循以上上限；认真讨论有独立上限，不为了短句牺牲完整回答。" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,12" />
                        <Label Content="颜文字用量" Target="{Binding ElementName=SldEmoji}" />
                        <Slider x:Name="SldEmoji" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnEmojiChanged" AutomationProperties.Name="颜文字用量百分比" />
                        <TextBlock x:Name="HintEmoji" Style="{StaticResource Small}" Margin="0,6,0,12" />
                        <Label Content="最多分几条消息" Target="{Binding ElementName=TxtBubbles}" />
                        <ui:NumberField x:Name="TxtBubbles" Minimum="1" Maximum="8" Fallback="2" Label="最多分几条消息" LostFocus="OnFieldLostFocus" />
                        <TextBlock Text="仅在长回复或请求分开发送时拆分，短回复保持一条。" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border x:Name="SecMemory" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="上下文与记忆" Style="{StaticResource H2}" />
                        <TextBlock Text="决定每轮带入多少历史，不改变人设。实际还受对话预算限制，越大通常越耗输入 token。" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><Label Content="私聊历史条数" Target="{Binding ElementName=TxtTurns}" /><ui:NumberField x:Name="TxtTurns" Minimum="4" Maximum="400" Fallback="120" Label="私聊历史条数" LostFocus="OnFieldLostFocus" /></StackPanel>
                            <StackPanel Grid.Column="1"><Label Content="群聊历史条数" Target="{Binding ElementName=TxtGroupTurns}" /><ui:NumberField x:Name="TxtGroupTurns" Minimum="2" Maximum="300" Fallback="100" Label="群聊历史条数" LostFocus="OnFieldLostFocus" /></StackPanel>
                        </Grid>
                        <Expander Header="清空指定对话记忆" Foreground="{DynamicResource Text}" Margin="0,16,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="清除所选会话的内部历史、摘要和人物记忆；不删微信聊天记录、人设或其他会话。此操作无法直接撤销，请先确认已有备份。" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <ComboBox x:Name="CmbMemoryChat" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="选择要清空记忆的会话" />
                                <WrapPanel Margin="0,10,0,0"><Button x:Name="BtnRefreshMemory" Content="刷新对话列表" Style="{StaticResource Ghost}" Click="OnRefreshMemoryChats" Margin="0,0,8,8" /><Button x:Name="BtnResetMemory" Content="清空该对话记忆" Style="{StaticResource Ghost}" Click="OnResetChatMemory" IsEnabled="False" Margin="0,0,0,8" /></WrapPanel>
                                <TextBlock x:Name="MemoryHint" Text="启动内核后可读取对话列表。" Style="{StaticResource Small}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
                <TextBlock Text="联网与链接在「设置」管理；插件、表情包和主动发送在各自页面管理。实现与维护选项收纳到「设置 → 高级模式」，不再重复列在人设里。" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="4,0,4,16" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="SaveState" Grid.Row="2" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
