<UserControl x:Class="WhaleLauncher.Views.PluginToolPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0">
        <TextBlock x:Name="Title" Style="{StaticResource H1}" />
        <TextBlock x:Name="Description" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,14" />
        <Border Style="{StaticResource Card}" Padding="14">
            <StackPanel>
                <StackPanel x:Name="InputPanel">
                    <TextBlock Text="输入文本" Style="{StaticResource Small}" Margin="0,0,0,6" />
                    <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"
                             MaxHeight="300" MaxLength="65536" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
                <StackPanel x:Name="DigestPanel" Visibility="Collapsed">
                    <TextBlock Text="选择汇总日期。生成前会提示确认模型如何使用聊天内容。"
                               Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ComboBox x:Name="DateRange" SelectedIndex="0" Width="140" HorizontalAlignment="Left">
                        <ComboBoxItem Content="今天" />
                        <ComboBoxItem Content="昨天" />
                    </ComboBox>
                </StackPanel>
                <Button x:Name="Run" Style="{StaticResource Primary}" Content="运行" HorizontalAlignment="Left"
                        Click="OnRun" Margin="0,10,0,0" />
                <TextBlock x:Name="Result" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
