<UserControl x:Class="WhaleLauncher.Views.StatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：标题 + 一句话说明，右侧只留刷新（启动 / 停止在顶栏） -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="状态" Style="{StaticResource H1}" />
                <TextBlock Text="内核、桥接、账号与本轮用量" Style="{StaticResource Small}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="BtnRefresh" Content="⟳ 刷新" Style="{StaticResource Ghost}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRefresh" />
        </Grid>

        <!-- 三卡 -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,20,0,0">
            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotNode" Width="8" Height="8" Fill="{DynamicResource Idle}" VerticalAlignment="Center" />
                        <TextBlock Text="内核" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="NodeAge" Style="{StaticResource Small}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="NodeMain" Text="未启动" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" Margin="0,10,0,0" />
                    <TextBlock x:Name="NodeSub" Text="—" Style="{StaticResource Small}" Margin="0,6,0,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotBridge" Width="8" Height="8" Fill="{DynamicResource Idle}" VerticalAlignment="Center" />
                        <TextBlock Text="桥接" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="BridgeAge" Style="{StaticResource Small}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="BridgeMain" Text="未启动" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" Margin="0,10,0,0" />
                    <TextBlock x:Name="BridgeSub" Text="—" Style="{StaticResource Small}" Margin="0,6,0,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotWechat" Width="8" Height="8" Fill="{DynamicResource Idle}" VerticalAlignment="Center" />
                        <TextBlock Text="微信" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="WechatMain" Text="未知" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" Margin="0,10,0,0" />
                    <TextBlock x:Name="WechatSub" Text="—" Style="{StaticResource Small}" Margin="0,6,0,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 用量 + 主动搭话 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock x:Name="UsageLine" Text="本次运行  —" Style="{StaticResource Value}" FontSize="13" />
                <TextBlock x:Name="RoundUsageLine" Text="本轮用量  —" Style="{StaticResource Small}"
                           Margin="0,7,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="CareLine" Text="主动搭话  —" Style="{StaticResource Small}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- 最近动态 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left" Text="最近动态" Style="{StaticResource H2}" />
                    <TextBlock x:Name="RecentHint" DockPanel.Dock="Right" Style="{StaticResource Small}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <Grid>
                    <ListBox x:Name="Recent" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="row" Background="Transparent" CornerRadius="4" Padding="8,4">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource Hover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Who}" Foreground="{DynamicResource Muted}"
                                               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{DynamicResource Text}"
                                               FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="RecentEmpty" Text="还没有消息。先发一条消息试试。"
                               Style="{StaticResource Small}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- 排障动作统一在「诊断」页和底栏，这里不再重复放一遍 -->
    </Grid>
</UserControl>
