<UserControl x:Class="WhaleLauncher.Views.StatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WhaleLauncher.Views"
             Background="Transparent">
    <Grid Margin="28,20,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <DockPanel x:Name="SectionHeader" Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="状态" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Content="⟳ 刷新" Style="{StaticResource Ghost}"
                    Padding="12,5" HorizontalAlignment="Right" Click="OnRefresh" />
        </DockPanel>

        <!-- 三卡：结构在 ReadOnlyDisplay.StatusCard 里，这里只给标题和初始值 -->
        <UniformGrid x:Name="SectionCards" Grid.Row="1" Columns="3" Margin="0,16,0,0">
            <views:StatusCard x:Name="CardNode" Label="内核" Margin="0,0,10,0" />
            <views:StatusCard x:Name="CardBridge" Label="桥接" Margin="0,0,10,0" />
            <views:StatusCard x:Name="CardWechat" Label="微信" MainText="未知" ShowMeta="False" />
        </UniformGrid>

        <!-- 用量 + 主动搭话 -->
        <Border x:Name="SectionUsage" Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="UsageLine" Text="本次运行  —" Style="{StaticResource Value}" FontSize="13" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RoundUsageLine" Text="本轮用量  —" Style="{StaticResource Small}" TextWrapping="Wrap" />
                    <TextBlock x:Name="CareLine" Grid.Column="1" Text="主动搭话  —" Style="{StaticResource Small}"
                               Margin="12,0,0,0" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 最近动态 -->
        <Border x:Name="SectionRecent" Grid.Row="3" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="最近动态" Style="{StaticResource H2}" />
                    <TextBlock x:Name="RecentHint" DockPanel.Dock="Right" Style="{StaticResource Small}" />
                </DockPanel>
                <Grid VerticalAlignment="Top">
                    <ListBox x:Name="Recent" Background="Transparent" BorderThickness="0" MaxHeight="380" VerticalAlignment="Top"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Who}" Foreground="{DynamicResource Muted}"
                                               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{DynamicResource Text}"
                                               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="RecentEmpty" Text="还没有消息。先在微信里跟她说一句。"
                               Style="{StaticResource Small}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- 排障动作统一在「诊断」页和底栏，这里不再重复放一遍 -->
    </Grid>
</UserControl>
