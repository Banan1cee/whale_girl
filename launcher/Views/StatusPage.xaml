<UserControl x:Class="WhaleLauncher.Views.StatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="状态" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Content="⟳ 刷新" Style="{StaticResource Ghost}"
                    HorizontalAlignment="Right" Click="OnRefresh" />
        </DockPanel>

        <!-- 三卡 -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,16,0,0">
            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,10,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotNode" Width="9" Height="9" Fill="{DynamicResource Idle}" VerticalAlignment="Center" />
                        <TextBlock Text="内核" Style="{StaticResource Label}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="NodeAge" Style="{StaticResource Small}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="NodeMain" Text="未启动" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" Margin="0,9,0,0" />
                    <TextBlock x:Name="NodeSub" Text="—" Style="{StaticResource Small}" Margin="0,5,0,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,10,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotBridge" Width="9" Height="9" Fill="{DynamicResource Idle}" VerticalAlignment="Center" />
                        <TextBlock Text="桥接" Style="{StaticResource Label}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="BridgeAge" Style="{StaticResource Small}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="BridgeMain" Text="未启动" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" Margin="0,9,0,0" />
                    <TextBlock x:Name="BridgeSub" Text="—" Style="{StaticResource Small}" Margin="0,5,0,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotWechat" Width="9" Height="9" Fill="{DynamicResource Idle}" VerticalAlignment="Center" />
                        <TextBlock Text="微信" Style="{StaticResource Label}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="WechatMain" Text="未知" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" Margin="0,9,0,0" />
                    <TextBlock x:Name="WechatSub" Text="—" Style="{StaticResource Small}" Margin="0,5,0,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 用量 + 主动搭话 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="UsageLine" Text="本次运行  —" Style="{StaticResource Value}" FontSize="13" />
                <TextBlock x:Name="RoundUsageLine" Text="本轮用量  —" Style="{StaticResource Small}"
                           Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="CareLine" Text="主动搭话  —" Style="{StaticResource Small}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- 主机：手机远程操作这台电脑前，先看清它锁没锁、会不会睡着 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <!-- 教程放在官网；页面没上线前用首页锚点，上线后只需改 HostHelpUrl 一处 -->
                    <Button x:Name="BtnHostHelp" Content="?" Style="{StaticResource Ghost}" DockPanel.Dock="Right"
                            Width="24" Padding="0" FontSize="12" VerticalAlignment="Top" Margin="10,0,0,0"
                            ToolTip="查看手机远程控制教程（在浏览器打开官网）" Click="OnHostHelp" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HostLine" Text="会话  —" Style="{StaticResource Value}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="HostConfigLine" Text="—" Style="{StaticResource Small}" Margin="0,5,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <!-- 选项单独一行并允许换行：窗口窄时不会挤在状态文字后面 -->
                <WrapPanel x:Name="HostOptions" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="保活" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="HostKeepAwake" Width="86" VerticalAlignment="Center"
                                  ToolTip="保活模式：关 / 防睡眠 / 防关屏" SelectionChanged="OnHostKeepAwakeChanged">
                            <ComboBoxItem Content="关" />
                            <ComboBoxItem Content="防睡眠" />
                            <ComboBoxItem Content="防关屏" />
                        </ComboBox>
                    </StackPanel>
                    <Button x:Name="BtnDisplayOff" Content="关闭屏幕" Style="{StaticResource Ghost}"
                            Margin="0,0,8,0" Click="OnDisplayOff" />
                    <CheckBox x:Name="ChkRemoteProcess" Content="允许手机启动内核" Margin="0,0,14,0"
                              VerticalAlignment="Center" Click="OnRemoteProcessChanged" />
                    <CheckBox x:Name="ChkAutoStart" Content="开机自启" Margin="0,0,14,0"
                              VerticalAlignment="Center" Click="OnAutoStartChanged" />
                    <!-- 远程开关屏幕默认关：勾上之后桌面/手机才出现亮屏与关屏按钮 -->
                    <CheckBox x:Name="ChkDisplayControl" Content="允许远程开关屏幕"
                              VerticalAlignment="Center" Click="OnDisplayControlChanged" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 最近动态 -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="最近动态" Style="{StaticResource H2}" />
                    <TextBlock x:Name="RecentHint" DockPanel.Dock="Right" Style="{StaticResource Small}" />
                </DockPanel>
                <Grid>
                    <ListBox x:Name="Recent" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" Padding="0,3">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Who}" Foreground="{DynamicResource Muted}"
                                               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{DynamicResource Text}"
                                               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="RecentEmpty" Text="还没有消息。先在微信里跟她说一句。"
                               Style="{StaticResource Small}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- 排障动作统一在「诊断」页和底栏，这里不再重复放一遍 -->
    </Grid>
</UserControl>
