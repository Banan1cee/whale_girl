<UserControl x:Class="WhaleLauncher.Views.ContactCheckList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" VerticalContentAlignment="Center"
                     TextChanged="OnSearchChanged" ToolTip="按名字 / 备注 / wxid 搜" />
            <Button x:Name="BtnReload" Grid.Column="1" Content="⟳ 刷新" Style="{StaticResource Ghost}"
                    Margin="8,0,0,0" Click="OnReload" />
        </Grid>

        <CheckBox x:Name="AllMuteCheck" Content="全部静音（*）" Margin="0,9,0,0"
                  Checked="OnAllMuteChanged" Unchecked="OnAllMuteChanged" />
        <TextBlock x:Name="AllMuteHint" Style="{StaticResource Small}"
                   Foreground="{DynamicResource Warn}" TextWrapping="Wrap"
                   Margin="21,4,0,0" Visibility="Collapsed" />

        <Border x:Name="ListCard" Style="{StaticResource Card}" Padding="6" Margin="0,9,0,0" Height="168">
            <Grid>
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" Padding="2,0">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="OnItemToggled"
                                      HorizontalContentAlignment="Stretch" Padding="4,5"
                                      ToolTip="{Binding Wxid}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Display}" Foreground="{DynamicResource Text}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Small}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource Surface3}" CornerRadius="3"
                                            Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding GroupBadgeVisibility}">
                                        <TextBlock Text="群" Foreground="{DynamicResource Accent}" FontSize="10" />
                                    </Border>
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="StateText" Style="{StaticResource Small}" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="20" Visibility="Collapsed" />
            </Grid>
        </Border>

        <TextBlock x:Name="FootText" Style="{StaticResource Small}" Margin="0,6,0,0"
                   Text="已选 0 个 · 勾选即保存" />
        <TextBlock x:Name="ErrorText" Style="{StaticResource Small}" Foreground="{DynamicResource Bad}"
                   TextWrapping="Wrap" Margin="0,3,0,0" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
