<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <!-- 第 2 轮：安装包。文件名带版本号（whale-girl-4.0.0-setup.exe），
       用通配符；默认 max-matches=1，所以必须只匹配到一个文件。

       metadata restrictions 对上 installer/whale.iss 里的
       VersionInfoProductName / VersionInfoCompany / VersionInfoProductTextVersion。 -->
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="whale-girl-*-setup.exe"
             product-name="WhaleGirl"
             company-name="WhaleGirl"
             product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
